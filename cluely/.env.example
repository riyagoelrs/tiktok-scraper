# Copy to cluely/.env and fill in. Never commit the real file.

# --- required ---------------------------------------------------------------
# https://console.anthropic.com  — drafts the answers
ANTHROPIC_API_KEY=
# https://console.deepgram.com  — streaming speech-to-text for both audio streams
DEEPGRAM_API_KEY=

# --- answers ----------------------------------------------------------------
ANSWER_MODEL=claude-opus-5
# low | medium | high | xhigh | max. Live calls want low: an answer that lands
# after the moment has passed is worth nothing.
ANSWER_EFFORT=low
# off | adaptive. `off` is fastest; `adaptive` is smarter on tangled questions.
ANSWER_THINKING=off
ANSWER_MAX_TOKENS=1200
# Answer question-shaped utterances without being asked.
AUTO_ANSWER=true
# Transcript lines handed to Claude with each question.
CONTEXT_LINES=24

# --- transcription ----------------------------------------------------------
STT_PROVIDER=deepgram
DEEPGRAM_MODEL=nova-3
STT_LANGUAGE=en

# --- capture ----------------------------------------------------------------
# Leave empty to capture system audio via loopback (Windows, and macOS 13+).
# Set it to part of an input device's name to read from a virtual cable instead,
# e.g. "BlackHole", "VB-Audio", "Monitor of".
SYSTEM_AUDIO_DEVICE=

# --- overlay ----------------------------------------------------------------
# Keeps the overlay out of screen shares and screenshots. Set false to debug.
CONTENT_PROTECTION=true

# Absolute path to your notes file. Defaults to cluely/context.md.
# CLUELY_CONTEXT=
